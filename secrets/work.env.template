# Work (Adit / Asseco) test values. Copy to secrets/work.env and fill locally.
# Never commit work.env. Never copy values into context files, memory, commits or chat.
# Referenced from context files as `secrets/work.env: KEY`.

# --- Nexus (Asseco, VPN) ---
# VSZP reads NEXUS_USER/NEXUS_PASSWORD; SEZAM repos read NEXUS_USERNAME/NEXUS_PASSWORD or local.properties
NEXUS_USER=
NEXUS_USERNAME=
NEXUS_PASSWORD=

# --- Asseco GitLab ---
# Fine-grained PAT, scope group SEZAM, Code = Download + Read (sezam-ai mirroring)
ASSECO_GITLAB_PAT=

# --- VSZP app test login (HLT envs) ---
VSZP_TEST_USER=
VSZP_TEST_PASSWORD=
VSZP_HLT_SMS_CODE=
VSZP_HLT_TEST_PIN=
# Debug unlock PIN (UnlockUserScreen in DEBUG builds)
VSZP_DEBUG_UNLOCK_PIN=
# VSZP test policyholder accounts used in testing (poistenecId, names)
VSZP_TEST_POISTENEC_IDS=

# --- J&T mToken ITP-B (SK and CZ share the test user) ---
JT_ITPB_TEST_USER=
JT_ITPB_TEST_PASSWORD=
JT_ITPB_TEST_SMS=
JT_ITPB_TEST_PIN=
JT_ITPB_SEZAM_ID=
JT_SK_CONSOLE_SUBJECT_ID=

# --- SEZAM read-only Oracle (JTSR/JTCZ/SECV TEST+DEV), also in ~/.sezam/.env ---
SEZAM_DB_RO_USER=
SEZAM_DB_RO_PASSWORD=
